cmake_minimum_required(VERSION 3.21)

function(cleanup_installed_build package_name target_name)
    if(NOT package_name MATCHES "^(openblas|opencv)$" OR
            NOT target_name MATCHES "^[A-Za-z0-9_]+-[A-Za-z0-9_]+-[A-Za-z0-9_]+$")
        message(FATAL_ERROR "Invalid dependency cleanup target")
    endif()
    get_filename_component(project_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." REALPATH)
    set(build_dir "${project_dir}/build/${package_name}/${target_name}")
    if(NOT EXISTS "${build_dir}")
        return()
    endif()
    # Resolve links and verify the exact project-owned target before recursive removal.
    file(REAL_PATH "${build_dir}" cleanup_dir)
    file(RELATIVE_PATH cleanup_relative "${project_dir}" "${cleanup_dir}")
    if(NOT cleanup_relative STREQUAL "build/${package_name}/${target_name}")
        message(FATAL_ERROR "Refusing cleanup outside the expected build directory: ${cleanup_dir}")
    endif()
    if(package_name STREQUAL "openblas")
        set(install_dir "${project_dir}/dependencies/OpenBLAS/${target_name}")
        if(NOT EXISTS "${install_dir}/.build_stamp" OR
                NOT EXISTS "${install_dir}/include/openblas/cblas.h" OR
                NOT EXISTS "${install_dir}/include/openblas/openblas_config.h" OR
                (NOT EXISTS "${install_dir}/lib/openblas.lib" AND NOT EXISTS "${install_dir}/lib/libopenblas.a"))
            message(STATUS "Keeping ${build_dir}: OpenBLAS installation is incomplete")
            return()
        endif()
    else()
        set(install_dir "${project_dir}/dependencies/OpenCV/${target_name}")
        if(NOT EXISTS "${install_dir}/.build_stamp")
            message(STATUS "Keeping ${build_dir}: OpenCV is not installed")
            return()
        endif()
        set(manifest_file "${install_dir}/.install_manifest.txt")
        if(NOT EXISTS "${manifest_file}")
            # Preserve metadata for installations made before cleanup was supported.
            file(STRINGS "${install_dir}/.build_stamp" installed_key)
            list(LENGTH installed_key key_length)
            if(key_length LESS 2)
                message(FATAL_ERROR "OpenCV install stamp is invalid; keeping its build directory")
            endif()
            list(GET installed_key 0 source_dir)
            list(GET installed_key 1 contrib_dir)
            string(SHA256 source_hash "${source_dir}\n${contrib_dir}")
            string(SUBSTRING "${source_hash}" 0 12 source_hash)
            if(NOT EXISTS "${build_dir}/${source_hash}/install_manifest.txt")
                message(FATAL_ERROR "OpenCV install manifest is missing; keeping its build directory")
            endif()
            configure_file("${build_dir}/${source_hash}/install_manifest.txt" "${manifest_file}" COPYONLY)
        endif()
        file(STRINGS "${manifest_file}" installed_files)
        if(NOT installed_files)
            message(FATAL_ERROR "OpenCV install manifest is empty; keeping its build directory")
        endif()
        foreach(installed_file IN LISTS installed_files)
            if(NOT EXISTS "${installed_file}")
                message(STATUS "Keeping ${build_dir}: installed OpenCV file is missing: ${installed_file}")
                return()
            endif()
        endforeach()
    endif()
    file(REMOVE_RECURSE "${cleanup_dir}")
    if(EXISTS "${cleanup_dir}")
        message(FATAL_ERROR "Could not remove dependency build directory: ${cleanup_dir}")
    endif()
    message(STATUS "Removed ${cleanup_dir}")
endfunction()

if(DEFINED cleanup_package)
    if(cleanup_package STREQUAL "all")
        cleanup_installed_build(openblas "${target_name}")
        cleanup_installed_build(opencv "${target_name}")
    else()
        cleanup_installed_build("${cleanup_package}" "${target_name}")
    endif()
endif()
